# Supabase project, Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public base URL, used for the self check-in QR link
APP_URL=http://localhost:3000

# Password that unlocks admin for any signed-in account
ADMIN_PASSWORD=

# Comma separated emails that always get admin on sign-in
ADMIN_EMAILS=
